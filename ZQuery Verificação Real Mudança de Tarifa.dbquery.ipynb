   "source": [
    "SELECT \n",
    "    f.dim_household_lclid, \n",
    "    COUNT(DISTINCT d.type) as numero_de_tarifas_diferentes\n",
    "FROM smart_meters.gold.fact_consumption f\n",
    "JOIN smart_meters.gold.dim_tariffs d\n",
    "    ON f.dim_tariff_sk = d.sk\n",
    "GROUP BY dim_household_lclid\n",
    "HAVING COUNT(DISTINCT d.type) > 1;"
   ]
  }
 ],
